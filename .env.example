# Copie para .env.local. NUNCA coloque chaves secretas aqui:
# tudo que começa com VITE_ vai para o navegador.

# "mock" (padrão): roda 100% local com dados fictícios, sem Supabase.
# "supabase": usa Supabase Auth e a Edge Function de IA.
VITE_DATA_MODE=mock

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# No modo supabase a busca usa o Google Places. Use "mock" para testar o banco
# sem chave do Google (busca nas 24 empresas fictícias).
VITE_SEARCH_PROVIDER=google_places

# Segredos do servidor (Claude API, Service Role) ficam nos secrets do Supabase:
#   supabase secrets set ANTHROPIC_API_KEY=...
#   supabase secrets set GOOGLE_PLACES_API_KEY=...
