# Variáveis do serviço WhatsApp (configure no Railway, nunca no site).
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave secreta do Supabase (Project Settings → API Keys → Secret key, sb_secret_...). Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=
# Chave para criptografar a sessão do WhatsApp no banco: 64 caracteres hex (npm run gen-key).
WA_ENCRYPTION_KEY=
# Endereço do site que pode chamar o serviço (separe vários por vírgula).
ALLOWED_ORIGINS=https://lead-hunter-beige-chi.vercel.app
# Limites de segurança do envio individual.
SEND_MIN_INTERVAL_SECONDS=8
SEND_DAILY_LIMIT=60
